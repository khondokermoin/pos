# ============================================================
#  HOSTINGER SHARED HOSTING — .env TEMPLATE
#  এই file টি copy করে .env নামে save করুন
#  তারপর নিচের সব *** VALUE *** গুলো আপনার তথ্য দিয়ে পূরণ করুন
# ============================================================

APP_NAME="Cloud POS"
APP_ENV=production
APP_KEY=                          # ← খালি রাখুন, deploy এর পর: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com    # ← আপনার আসল domain দিন (e.g. https://pos.example.com)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # production এ error রাখুন

# ─── Database (Hostinger hPanel থেকে নিন) ─────────────────
DB_CONNECTION=mysql
DB_HOST=localhost                 # Hostinger এ সাধারণত localhost
DB_PORT=3306
DB_DATABASE=your_db_name          # ← hPanel > Databases থেকে DB name
DB_USERNAME=your_db_username      # ← hPanel > Databases থেকে DB username
DB_PASSWORD=your_db_password      # ← hPanel > Databases থেকে DB password

# ─── Session / Cache / Queue ───────────────────────────────
SESSION_DRIVER=file               # Shared hosting এ file ব্যবহার করুন
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync             # Shared hosting এ sync রাখুন

CACHE_STORE=file                  # Shared hosting এ file ব্যবহার করুন

# ─── Mail (Gmail SMTP) ─────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com        # ← আপনার Gmail
MAIL_PASSWORD=your_gmail_app_password     # ← Gmail App Password (16 digit)
MAIL_FROM_ADDRESS=noreply@yourdomain.com  # ← আপনার domain email
MAIL_FROM_NAME="${APP_NAME}"

# ─── SSLCommerz Payment Gateway ───────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id         # ← SSLCommerz থেকে নিন
SSLCOMMERZ_STORE_PASSWORD=your_store_pass # ← SSLCommerz থেকে নিন
SSLCOMMERZ_IS_SANDBOX=false               # ← Live এ false করুন

# ─── AWS S3 (Optional — file upload এর জন্য) ──────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
